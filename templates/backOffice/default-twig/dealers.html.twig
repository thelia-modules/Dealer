{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Dealer'|trans({}, 'dealer.bo.default') }}{% endblock %}

{% block body_testid %}dealer-list{% endblock %}

{% block content %}
    <div id="wrapper" class="container-fluid">
        {% if general_error is defined and general_error %}
            <div class="alert alert-danger">{{ general_error }}</div>
        {% endif %}

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title mb-0">{{ 'Dealer'|trans({}, 'dealer.bo.default') }}</span>
                {% if is_granted('CREATE', {resource: 'admin.module', module: 'Dealer'}) %}
                    <button type="button" class="btn btn-primary btn-sm" title="{{ 'Create a new Dealer entry'|trans({}, 'dealer.bo.default') }}"
                            data-bs-toggle="modal" data-bs-target="#dealer-create">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped" id="dealer-table">
                        <thead>
                        <tr>
                            <th>{{ 'Company'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Visible'|trans }}</th>
                            <th>{{ 'Address1'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Zipcode'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'City'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Country'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Actions'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for dealer in dealers %}
                            <tr>
                                <td>
                                    <a href="/admin/module/Dealer/dealer/edit?dealer_id={{ dealer.id }}">{{ dealer.title }}</a>
                                </td>
                                <td>
                                    {% if is_granted('UPDATE', {resource: 'admin.module', module: 'Dealer'}) %}
                                        <div class="form-check form-switch">
                                            <input class="form-check-input dealer-toggle-visible" type="checkbox"
                                                   role="switch" data-id="{{ dealer.id }}"{{ dealer.visible ? ' checked' : '' }}>
                                        </div>
                                    {% else %}
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   disabled{{ dealer.visible ? ' checked' : '' }}>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>{{ dealer.address1 }}</td>
                                <td>{{ dealer.zipcode }}</td>
                                <td>{{ dealer.city }}</td>
                                <td>{{ dealer.country }}</td>
                                <td>
                                    <div class="btn-group">
                                        {% if is_granted('UPDATE', {resource: 'admin.module', module: 'Dealer'}) %}
                                            <a class="btn btn-secondary btn-sm" title="{{ 'Edit this Dealer'|trans({}, 'dealer.bo.default') }}"
                                               href="/admin/module/Dealer/dealer/edit?dealer_id={{ dealer.id }}">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        {% endif %}
                                        {% if is_granted('DELETE', {resource: 'admin.module', module: 'Dealer'}) %}
                                            <button type="button" class="btn btn-secondary btn-sm dealer-delete"
                                                    title="{{ 'Delete this Dealer'|trans({}, 'dealer.bo.default') }}"
                                                    data-bs-toggle="modal" data-bs-target="#dealer-delete" data-id="{{ dealer.id }}">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7">
                                    <div class="alert alert-info mb-0">{{ 'There is no Dealer'|trans({}, 'dealer.bo.default') }}</div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% include 'dealer-create.html.twig' with  {create_form} %}

    {# DELETE modal #}
    <div class="modal fade" id="dealer-delete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="/admin/module/Dealer/dealer/delete?_token={{ assignToken() }}">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Delete an entry of Dealer'|trans({}, 'dealer.bo.default') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ 'Do you really want to delete this Dealer entry ?'|trans({}, 'dealer.bo.default') }}
                        <input type="hidden" name="dealer_id" id="dealer_delete_id" value="">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {{ safe_hook('dealer.js') }}
{% endblock %}

{% block scripts_extra %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('a.dealer-delete, button.dealer-delete').forEach(function (el) {
                el.addEventListener('click', function () {
                    var input = document.getElementById('dealer_delete_id');
                    if (input) {
                        input.value = this.dataset.id;
                    }
                });
            });

            document.querySelectorAll('.dealer-toggle-visible').forEach(function (el) {
                el.addEventListener('change', function () {
                    fetch('/admin/module/Dealer/dealer/toggle-online/' + this.dataset.id + '?_token={{ assignToken() }}', {
                        method: 'POST',
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    });
                });
            });
        });
    </script>
{% endblock %}
