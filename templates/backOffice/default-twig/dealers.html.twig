{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Dealer'|trans({}, 'dealer.bo.default') }}{% endblock %}

{% block body_testid %}dealer-list{% endblock %}

{% block content %}
    <div id="wrapper" class="container-fluid">
        {% if general_error is defined and general_error %}
            <div class="alert alert-danger">{{ general_error }}</div>
        {% endif %}

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title mb-0">{{ 'Dealer'|trans({}, 'dealer.bo.default') }}</span>
                {% if is_granted('CREATE', {resource: 'admin.module', module: 'Dealer'}) %}
                    <button type="button" class="btn btn-primary btn-sm" title="{{ 'Create a new Dealer entry'|trans({}, 'dealer.bo.default') }}"
                            data-bs-toggle="modal" data-bs-target="#dealer-create">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped" id="dealer-table">
                        <thead>
                        <tr>
                            <th>{{ 'Company'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Visible'|trans }}</th>
                            <th>{{ 'Address1'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Zipcode'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'City'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Country'|trans({}, 'dealer.bo.default') }}</th>
                            <th>{{ 'Actions'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for dealer in dealers %}
                            <tr>
                                <td>
                                    <a href="/admin/module/Dealer/dealer/edit?dealer_id={{ dealer.id }}">{{ dealer.title }}</a>
                                </td>
                                <td>
                                    {% if is_granted('UPDATE', {resource: 'admin.module', module: 'Dealer'}) %}
                                        <div class="form-check form-switch">
                                            <input class="form-check-input dealer-toggle-visible" type="checkbox"
                                                   role="switch" data-id="{{ dealer.id }}"{{ dealer.visible ? ' checked' : '' }}>
                                        </div>
                                    {% else %}
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   disabled{{ dealer.visible ? ' checked' : '' }}>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>{{ dealer.address1 }}</td>
                                <td>{{ dealer.zipcode }}</td>
                                <td>{{ dealer.city }}</td>
                                <td>{{ dealer.country }}</td>
                                <td>
                                    <div class="btn-group">
                                        {% if is_granted('UPDATE', {resource: 'admin.module', module: 'Dealer'}) %}
                                            <a class="btn btn-secondary btn-sm" title="{{ 'Edit this Dealer'|trans({}, 'dealer.bo.default') }}"
                                               href="/admin/module/Dealer/dealer/edit?dealer_id={{ dealer.id }}">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        {% endif %}
                                        {% if is_granted('DELETE', {resource: 'admin.module', module: 'Dealer'}) %}
                                            <button type="button" class="btn btn-secondary btn-sm dealer-delete"
                                                    title="{{ 'Delete this Dealer'|trans({}, 'dealer.bo.default') }}"
                                                    data-bs-toggle="modal" data-bs-target="#dealer-delete" data-id="{{ dealer.id }}">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7">
                                    <div class="alert alert-info mb-0">{{ 'There is no Dealer'|trans({}, 'dealer.bo.default') }}</div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# CREATE modal #}
    <div class="modal fade" id="dealer-create" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                {{ form_start(create_form, {action: '/admin/module/Dealer/dealer', attr: {class: 'modal-form'}}) }}
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Create an entry of Dealer'|trans({}, 'dealer.bo.default') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    {# The dealer is saved in the language chosen here: getCurrentEditionLang()
                       reads edit_language_id from the POST body. The locale field is kept in
                       sync so the form data stays consistent. #}
                    <div class="mb-3">
                        <label class="form-label" for="dealer-create-language">{{ 'Locale'|trans({}, 'dealer.bo.default') }}</label>
                        <select name="edit_language_id" id="dealer-create-language" class="form-select" data-dealer-create-language>
                            {% for lang in bo_languages() %}
                                <option value="{{ lang.id }}" data-locale="{{ lang.locale }}"{{ lang.id == edit_language_id ? ' selected' : '' }}>{{ lang.title }} ({{ lang.locale }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    {{ form_widget(create_form.locale, {type: 'hidden', value: edit_language_locale, id: 'dealer-create-locale'}) }}
                    {# success_url/error_url are form fields (BaseForm namespace); a bare
                       success_url input is ignored, which sent creation back to the front. #}
                    {{ form_widget(create_form.success_url, {value: '/admin/module/Dealer/dealer/edit?dealer_id=_ID_'}) }}
                    {{ form_widget(create_form.error_url, {value: '/admin/module/Dealer/dealer'}) }}

                    <div class="mb-3">
                        {{ form_label(create_form.title, 'Title'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.title, {attr: {class: 'form-control' ~ (create_form.title.vars.errors|length ? ' is-invalid' : ''), placeholder: 'The Dealer title'|trans({}, 'dealer.bo.default')}}) }}
                        {{ form_errors(create_form.title) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.address1, 'Address1'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.address1, {attr: {class: 'form-control' ~ (create_form.address1.vars.errors|length ? ' is-invalid' : ''), placeholder: 'The Dealer address1'|trans({}, 'dealer.bo.default')}}) }}
                        {{ form_errors(create_form.address1) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.address2, 'Address2'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.address2, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.address3, 'Address3'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.address3, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(create_form.zipcode, 'Zipcode'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(create_form.zipcode, {attr: {class: 'form-control' ~ (create_form.zipcode.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(create_form.zipcode) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(create_form.city, 'City'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(create_form.city, {attr: {class: 'form-control' ~ (create_form.city.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(create_form.city) }}
                        </div>
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.country_id, 'Country'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.country_id, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(create_form.country_id) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.description, 'Description'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.description, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.big_description, 'Complex Description'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.big_description, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.hard_open_hour, "Horraires d'ouverture"|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.hard_open_hour, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.access, 'Access'|trans({}, 'dealer.bo.default'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.access, {attr: {class: 'form-control'}}) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                    <button type="submit" class="btn btn-primary">{{ 'Create'|trans }}</button>
                </div>
                {{ form_end(create_form) }}
            </div>
        </div>
    </div>

    {# DELETE modal #}
    <div class="modal fade" id="dealer-delete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="/admin/module/Dealer/dealer/delete?_token={{ assignToken() }}">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Delete an entry of Dealer'|trans({}, 'dealer.bo.default') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ 'Do you really want to delete this Dealer entry ?'|trans({}, 'dealer.bo.default') }}
                        <input type="hidden" name="dealer_id" id="dealer_delete_id" value="">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {{ safe_hook('dealer.js') }}
{% endblock %}

{% block scripts_extra %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('a.dealer-delete, button.dealer-delete').forEach(function (el) {
                el.addEventListener('click', function () {
                    var input = document.getElementById('dealer_delete_id');
                    if (input) {
                        input.value = this.dataset.id;
                    }
                });
            });

            // Keep the hidden locale field aligned with the chosen creation language.
            var createLanguage = document.querySelector('[data-dealer-create-language]');
            var createLocale = document.getElementById('dealer-create-locale');
            if (createLanguage && createLocale) {
                createLanguage.addEventListener('change', function () {
                    var option = createLanguage.options[createLanguage.selectedIndex];
                    createLocale.value = option ? option.getAttribute('data-locale') : createLocale.value;
                });
            }

            document.querySelectorAll('.dealer-toggle-visible').forEach(function (el) {
                el.addEventListener('change', function () {
                    fetch('/admin/module/Dealer/dealer/toggle-online/' + this.dataset.id + '?_token={{ assignToken() }}', {
                        method: 'POST',
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    });
                });
            });
        });
    </script>
{% endblock %}
