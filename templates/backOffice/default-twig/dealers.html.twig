{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Dealer'|trans({}, 'dealer.bo.default-twig') }}{% endblock %}

{% block body_testid %}dealer-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Stores'|trans({}, 'dealer.bo.default-twig') }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div id="wrapper" class="container-fluid" data-testid="dealers-page">
        {% if general_error is defined and general_error %}
            <div class="alert alert-danger">{{ general_error }}</div>
        {% endif %}

        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Stores'|trans({}, 'dealer.bo.default-twig'), quick_chips: filters.quick_chips } %}
            {% block actions %}
                <div class="d-flex flex-wrap align-items-center gap-2" data-testid="dealer-quick-filters">
                    {% for chip in quick_chips %}
                        <a class="btn btn-sm {{ chip.active ? 'btn-primary' : 'btn-outline-secondary' }}"
                           href="{{ chip.url }}"
                           data-testid="dealer-quick-filter-{{ chip.code }}">{{ chip.label }}</a>
                    {% endfor %}
                </div>
                {% if is_granted('CREATE', {resource: 'admin.module', module: 'Dealer'}) %}
                    <button type="button" class="btn btn-primary btn-sm" title="{{ 'Create a new Dealer entry'|trans({}, 'dealer.bo.default-twig') }}"
                            data-bs-toggle="modal" data-bs-target="#dealer-create" data-testid="dealer-create-open">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    </button>
                {% endif %}
            {% endblock %}
        {% endembed %}

        <form method="get" action="{{ list_url }}" class="bo-order-filters" data-testid="dealer-search-form">
            {% if query_params.visible is defined %}
                <input type="hidden" name="visible" value="{{ query_params.visible }}">
            {% endif %}
            <div class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label" for="dealer-search-q">{{ 'Search'|trans({}, 'dealer.bo.default-twig') }}</label>
                    <input type="search" id="dealer-search-q" name="q" value="{{ filters.search }}"
                           class="form-control"
                           placeholder="{{ 'Name, address, zip code or city'|trans({}, 'dealer.bo.default-twig') }}"
                           data-testid="dealer-search-input">
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" data-testid="dealer-search-submit">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ 'Apply'|trans }}
                    </button>
                    <a href="{{ filters.clear_all_url }}" class="btn btn-outline-secondary" data-testid="dealer-reset">{{ 'Reset'|trans }}</a>
                </div>
            </div>
        </form>

        <div class="mt-3">
            {% set dealer_columns = [
                column_html('title_html', 'Store'|trans({}, 'dealer.bo.default-twig'), 'start', 'title'),
                column_html('address_html', 'Address'|trans({}, 'dealer.bo.default-twig'), 'start', 'city', visibleFrom: 'md'),
                column_toggle('visible', 'Online'|trans({}, 'dealer.bo.default-twig'), 'toggle_url'),
                column_actions('_actions', 'Actions'|trans),
            ] %}

            {{ component('BoDataTable', {
                id: 'dealers',
                columns: dealer_columns,
                rows: rows,
                emptyMessage: 'There is no Dealer'|trans({}, 'dealer.bo.default-twig'),
                sortField: sort.field,
                sortDirection: sort.direction,
                sortKeepParams: query_params,
            }) }}

            {{ component('BoPagination', {
                route: 'dealer',
                currentPage: current_page,
                lastPage: pages,
                routeParams: query_params|merge({order: sort.field, direction: sort.direction}),
                ariaLabel: 'Store pagination'|trans({}, 'dealer.bo.default-twig'),
                testid: 'dealer-pagination',
            }) }}
        </div>
    </div>

    {# CREATE modal #}
    <div class="modal fade" id="dealer-create" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                {{ form_start(create_form, {action: '/admin/module/Dealer/dealer', attr: {class: 'modal-form'}}) }}
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Create an entry of Dealer'|trans({}, 'dealer.bo.default-twig') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="dealer-create-language">{{ 'Locale'|trans({}, 'dealer.bo.default-twig') }}</label>
                        <select name="edit_language_id" id="dealer-create-language" class="form-select" data-dealer-create-language>
                            {% for lang in bo_languages() %}
                                <option value="{{ lang.id }}" data-locale="{{ lang.locale }}"{{ lang.id == edit_language_id ? ' selected' : '' }}>{{ lang.title }} ({{ lang.locale }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    {{ form_widget(create_form.locale, {type: 'hidden', value: edit_language_locale, id: 'dealer-create-locale'}) }}
                    {{ form_widget(create_form.success_url, {value: '/admin/module/Dealer/dealer/edit?dealer_id=_ID_', id: 'dealer-create-success-url'}) }}
                    {{ form_widget(create_form.error_url, {value: '/admin/module/Dealer/dealer'}) }}

                    <div class="mb-3">
                        {{ form_label(create_form.title, 'Title'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.title, {attr: {class: 'form-control' ~ (create_form.title.vars.errors|length ? ' is-invalid' : ''), placeholder: 'The Dealer title'|trans({}, 'dealer.bo.default-twig')}}) }}
                        {{ form_errors(create_form.title) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.address1, 'Address1'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.address1, {attr: {class: 'form-control' ~ (create_form.address1.vars.errors|length ? ' is-invalid' : ''), placeholder: 'The Dealer address1'|trans({}, 'dealer.bo.default-twig')}}) }}
                        {{ form_errors(create_form.address1) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.address2, 'Address2'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.address2, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.address3, 'Address3'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.address3, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(create_form.zipcode, 'Zipcode'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(create_form.zipcode, {attr: {class: 'form-control' ~ (create_form.zipcode.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(create_form.zipcode) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(create_form.city, 'City'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(create_form.city, {attr: {class: 'form-control' ~ (create_form.city.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(create_form.city) }}
                        </div>
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.country_id, 'Country'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.country_id, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(create_form.country_id) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.description, 'Description'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.description, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.big_description, 'Complex Description'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.big_description, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.hard_open_hour, "Opening hours (free text)"|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.hard_open_hour, {attr: {class: 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(create_form.access, 'Access'|trans({}, 'dealer.bo.default-twig'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(create_form.access, {attr: {class: 'form-control'}}) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                    <button type="submit" class="btn btn-primary">{{ 'Create'|trans }}</button>
                </div>
                {{ form_end(create_form) }}
            </div>
        </div>
    </div>

    {# DELETE modal #}
    <div class="modal fade" id="dealer-delete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="/admin/module/Dealer/dealer/delete">
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Delete an entry of Dealer'|trans({}, 'dealer.bo.default-twig') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ 'Do you really want to delete this Dealer entry ?'|trans({}, 'dealer.bo.default-twig') }}
                        <strong data-dealer-delete-title></strong>
                        <input type="hidden" name="dealer_id" id="dealer_delete_id" value="">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {{ safe_hook('dealer.js') }}
{% endblock %}

{% block scripts_extra %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('dealer-delete');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    var trigger = event.relatedTarget;
                    var input = document.getElementById('dealer_delete_id');
                    var label = deleteModal.querySelector('[data-dealer-delete-title]');
                    if (input && trigger) {
                        input.value = trigger.dataset.dealerId || '';
                    }
                    if (label && trigger) {
                        label.textContent = trigger.dataset.dealerTitle || '';
                    }
                });
            }

            var createLanguage = document.querySelector('[data-dealer-create-language]');
            var createLocale = document.getElementById('dealer-create-locale');
            var createSuccessUrl = document.getElementById('dealer-create-success-url');
            if (createLanguage && createLocale) {
                var successUrlBase = createSuccessUrl ? createSuccessUrl.value : null;
                function syncCreateLanguage() {
                    var option = createLanguage.options[createLanguage.selectedIndex];
                    if (!option) {
                        return;
                    }
                    createLocale.value = option.getAttribute('data-locale');
                    if (createSuccessUrl && successUrlBase) {
                        createSuccessUrl.value = successUrlBase + '&edit_language_id=' + option.value;
                    }
                }
                createLanguage.addEventListener('change', syncCreateLanguage);
                syncCreateLanguage();
            }
        });
    </script>
{% endblock %}
