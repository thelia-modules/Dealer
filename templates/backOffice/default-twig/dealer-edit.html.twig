{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Dealer edit'|trans({}, 'dealer.bo.default') }}{% endblock %}

{% block body_testid %}dealer-edit{% endblock %}

{% block content %}
    {% set fp = update_form.vars.full_name %}
    <div id="wrapper" class="container-fluid">
        {% if general_error is defined and general_error %}
            <div class="alert alert-danger">{{ general_error }}</div>
        {% endif %}

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title mb-0">
                    {{ 'Dealer edit'|trans({}, 'dealer.bo.default') }}{% if dealer %} - {{ dealer.title }}{% endif %}
                </span>
                <a href="{{ path('dealer') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> {{ 'Back to the dealers list'|trans({}, 'dealer.bo.default') }}
                </a>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs mb-3" id="dealer-edit-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">{{ 'General'|trans({}, 'dealer.bo.default') }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#metaseo" type="button" role="tab">{{ 'Meta SEO'|trans }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#images" type="button" role="tab">{{ 'Images'|trans }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#location" type="button" role="tab">{{ 'Location'|trans({}, 'dealer.bo.default') }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#contacts" type="button" role="tab">{{ 'Contacts'|trans }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#schedules" type="button" role="tab">{{ 'Schedules'|trans({}, 'dealer.bo.default') }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pickup-config" type="button" role="tab">{{ 'Pickup config'|trans({}, 'dealer.bo.default') }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#associated" type="button" role="tab">{{ 'Associated'|trans({}, 'dealer.bo.default') }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">{{ 'Users'|trans({}, 'dealer.bo.default') }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#modules" type="button" role="tab">{{ 'Modules'|trans }}</button>
                    </li>
                </ul>

                <div class="tab-content">
                    {# GENERAL #}
                    <div class="tab-pane fade show active" id="general" role="tabpanel">
                        <form method="POST" action="/admin/module/Dealer/dealer/edit?dealer_id={{ dealer_id }}" class="clearfix">
                            <input type="hidden" name="{{ fp }}[_token]" value="{{ update_form._token.vars.value }}">
                            <input type="hidden" name="{{ fp }}[success_url]" value="{{ path('dealer') }}">
                            <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}">
                            <input type="hidden" name="{{ fp }}[locale]" value="{{ edit_language_locale }}">
                            <input type="hidden" name="{{ fp }}[id]" value="{{ dealer_id }}">

                            <div class="mb-3">
                                <label class="form-label">{{ 'Title'|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.title, {attr: {class: 'form-control', placeholder: 'The Dealer title'|trans({}, 'dealer.bo.default')}}) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'Address1'|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.address1, {attr: {class: 'form-control'}}) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'Address2'|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.address2, {attr: {class: 'form-control'}}) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'Address3'|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.address3, {attr: {class: 'form-control'}}) }}
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">{{ 'Zipcode'|trans({}, 'dealer.bo.default') }}</label>
                                    {{ form_widget(update_form.zipcode, {attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="col-md-5 mb-3">
                                    <label class="form-label">{{ 'City'|trans({}, 'dealer.bo.default') }}</label>
                                    {{ form_widget(update_form.city, {attr: {class: 'form-control'}}) }}
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">{{ 'Country'|trans({}, 'dealer.bo.default') }}</label>
                                    {{ form_widget(update_form.country_id, {attr: {class: 'form-select'}}) }}
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'Description'|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.description, {attr: {class: 'form-control', rows: 3}}) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'Complex Description'|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.big_description, {attr: {class: 'form-control', rows: 3}}) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ "Horraires d'ouverture"|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.hard_open_hour, {attr: {class: 'form-control'}}) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ 'Access'|trans({}, 'dealer.bo.default') }}</label>
                                {{ form_widget(update_form.access, {attr: {class: 'form-control', rows: 3}}) }}
                            </div>

                            <div class="mt-3">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> {{ 'Save'|trans }}</button>
                            </div>

                            {% if dealer and dealer.created_at %}
                                <small class="text-muted d-block mt-2">
                                    {{ 'Dealer created on %created_at. Last modification: %updated_at'|trans({
                                        '%created_at': dealer.created_at|date('Y-m-d H:i'),
                                        '%updated_at': dealer.updated_at ? dealer.updated_at|date('Y-m-d H:i') : ''
                                    }, 'dealer.bo.default') }}
                                </small>
                            {% endif %}
                        </form>
                    </div>

                    {# META SEO #}
                    {% include 'Dealer/edit/tab-metaseo.html.twig' %}

                    {# IMAGES #}
                    {% include 'Dealer/edit/tab-images.html.twig' %}

                    {# LOCATION #}
                    {% include 'Dealer/edit/tab-location.html.twig' %}

                    {# CONTACTS #}
                    {% include 'Dealer/edit/tab-contacts.html.twig' %}

                    {# SCHEDULES #}
                    {% include 'Dealer/edit/tab-schedules.html.twig' %}

                    {% include 'Dealer/edit/tab-pickup-config.html.twig' %}

                    {# ASSOCIATED — driven by the dealer.associated.tabcontent hook #}
                    <div class="tab-pane fade" id="associated" role="tabpanel">
                        {% if has_hook('dealer.associated.tabcontent') %}
                            <div class="row">{{ hook('dealer.associated.tabcontent', {dealer_id: dealer_id}) }}</div>
                        {% else %}
                            <div class="alert alert-info mb-0">{{ 'No associated content for this dealer.'|trans({}, 'dealer.bo.default') }}</div>
                        {% endif %}
                    </div>

                    {# USERS #}
                    {% include 'Dealer/edit/tab-users.html.twig' %}

                    {# MODULES — driven by the dealer.extra.content.edit hook #}
                    <div class="tab-pane fade" id="modules" role="tabpanel">
                        {% if has_hook('dealer.extra.content.edit') %}
                            {{ hook('dealer.extra.content.edit', {dealer_id: dealer_id}) }}
                        {% else %}
                            <div class="alert alert-info mb-0">{{ 'There is no additionnal content for this Dealer'|trans({}, 'dealer.bo.default') }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Modals (contact, contact-info, schedules, admin link) #}
    {% include 'Dealer/edit/modals.html.twig' %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Activate the tab referenced by the URL hash, if any.
            var hash = window.location.hash;
            if (hash) {
                var trigger = document.querySelector('#dealer-edit-tabs [data-bs-target="' + hash + '"]');
                if (trigger) {
                    bootstrap.Tab.getOrCreateInstance(trigger).show();
                }
            }

            // Generic modal prefill: copy data-* attributes from the trigger into the modal inputs.
            document.querySelectorAll('.dealer-modal').forEach(function (modal) {
                modal.addEventListener('show.bs.modal', function (event) {
                    var trigger = event.relatedTarget;
                    if (!trigger) {
                        return;
                    }
                    modal.querySelectorAll('[data-fill]').forEach(function (input) {
                        var key = input.getAttribute('data-fill');
                        var value = trigger.getAttribute('data-' + key);
                        if (value !== null) {
                            input.value = value;
                        }
                    });
                    modal.querySelectorAll('[data-fill-select]').forEach(function (select) {
                        var key = select.getAttribute('data-fill-select');
                        var value = trigger.getAttribute('data-' + key);
                        if (value !== null) {
                            select.value = value;
                        }
                    });
                });
            });

            // Schedule modals: a default schedule uses a weekday (no date). An exceptional
            // opening/closure uses either a precise date (period_begin = period_end) or a period
            // (period_begin < period_end), switched by the Date/Period toggle.
            function setupScheduleFields(modal) {
                if (!modal) {
                    return null;
                }
                var dayField = modal.querySelector('[data-schedule-day-field]');
                var dateField = modal.querySelector('[data-schedule-date-field]');
                var dateInput = modal.querySelector('[data-schedule-date]');
                var periodEnd = modal.querySelector('[data-schedule-period-end]');
                var endWrap = modal.querySelector('[data-schedule-end-wrap]');
                var beginLabel = modal.querySelector('[data-schedule-begin-label]');
                var modeRadios = modal.querySelectorAll('[data-schedule-exc-mode]');

                function applyExcMode(mode) {
                    var isPeriod = mode === 'period';
                    if (beginLabel) {
                        beginLabel.textContent = isPeriod
                            ? beginLabel.getAttribute('data-label-period')
                            : beginLabel.getAttribute('data-label-date');
                    }
                    if (endWrap) {
                        endWrap.style.display = isPeriod ? '' : 'none';
                    }
                    // Single date: mirror period_end onto the chosen date (a one-day range).
                    if (!isPeriod && dateInput && periodEnd) {
                        periodEnd.value = dateInput.value;
                    }
                }

                // Keep period_end mirrored while in single-date mode.
                if (dateInput && periodEnd) {
                    dateInput.addEventListener('change', function () {
                        var current = modal.querySelector('[data-schedule-exc-mode]:checked');
                        if (!current || current.value !== 'period') {
                            periodEnd.value = dateInput.value;
                        }
                    });
                }
                Array.prototype.forEach.call(modeRadios, function (radio) {
                    radio.addEventListener('change', function () {
                        if (radio.checked) {
                            applyExcMode(radio.value);
                        }
                    });
                });

                return function applyFields(useDate, mode) {
                    if (dayField) {
                        dayField.style.display = useDate ? 'none' : '';
                    }
                    if (dateField) {
                        dateField.style.display = useDate ? '' : 'none';
                    }
                    if (useDate) {
                        if (dayField) {
                            dayField.querySelectorAll('select').forEach(function (select) {
                                Array.prototype.forEach.call(select.options, function (option) {
                                    option.selected = false;
                                });
                            });
                        }
                        var wanted = mode === 'period' ? 'period' : 'date';
                        Array.prototype.forEach.call(modeRadios, function (radio) {
                            radio.checked = radio.value === wanted;
                        });
                        applyExcMode(wanted);
                    } else {
                        if (dateInput) { dateInput.value = ''; }
                        if (periodEnd) { periodEnd.value = ''; }
                    }
                };
            }

            // Create-schedule modal: title from the clicked section; weekday for default hours,
            // a precise date (default) for exceptional openings/closures (data-schedule-period = '1').
            var scheduleCreateModal = document.getElementById('dealer-schedules-create');
            var applyCreateFields = setupScheduleFields(scheduleCreateModal);
            if (scheduleCreateModal && applyCreateFields) {
                scheduleCreateModal.addEventListener('show.bs.modal', function (event) {
                    var trigger = event.relatedTarget;
                    if (!trigger) {
                        return;
                    }
                    var title = trigger.getAttribute('data-schedule-title');
                    var titleEl = scheduleCreateModal.querySelector('[data-schedule-create-title]');
                    if (title && titleEl) {
                        titleEl.textContent = title;
                    }
                    applyCreateFields(trigger.getAttribute('data-schedule-period') === '1', 'date');
                });
            }

            // Update-schedule modal: an entry with a date edits as an exception (precise date when
            // period_begin = period_end, otherwise a period), else as a weekday. The generic prefill
            // runs first, so this refreshes the visible fields after.
            var scheduleUpdateModal = document.getElementById('dealer-schedules-update');
            var applyUpdateFields = setupScheduleFields(scheduleUpdateModal);
            if (scheduleUpdateModal && applyUpdateFields) {
                scheduleUpdateModal.addEventListener('show.bs.modal', function (event) {
                    var trigger = event.relatedTarget;
                    if (!trigger) {
                        return;
                    }
                    var periodBegin = trigger.getAttribute('data-periodbegin');
                    var periodEnd = trigger.getAttribute('data-periodend');
                    var useDate = periodBegin !== null && periodBegin !== '';
                    var mode = (useDate && periodEnd && periodEnd !== periodBegin) ? 'period' : 'date';
                    applyUpdateFields(useDate, mode);
                });
            }
        });
    </script>

    {{ safe_hook('dealer.edit.js') }}
{% endblock %}
