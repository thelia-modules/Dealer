<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="h5 mb-0">{{ 'Link a Product'|trans({}, 'dealer.bo.default') }}</h3>
            </div>
            <div class="card-body">
                <form action="/admin/module/Dealer/product" method="POST">
                    {% set prefix = dealer_product_link_form.vars.full_name %}
                    <input type="hidden" name="{{ prefix }}[_token]" value="{{ dealer_product_link_form._token.vars.value }}">
                    <input type="hidden" name="{{ prefix }}[success_url]" value="{{ dealer_current_url~'#tab-modules' }}">
                    <input type="hidden" name="{{ prefix }}[product_id]" value="{{ dealer_product_id }}">
	                {% if dealer_all_dealers|length == dealer_linked_dealers|length %}
		                <div class="alert alert-info mb-3">{{ 'There is no dealer'|trans({}, 'dealer.bo.default') }}</div>
		                {% else %}
	                    <div class="mb-3">
	                        <label class="form-label" for="dealer-product-link-dealer">
	                            {{ 'Dealer'|trans({}, 'dealer.bo.default') }} <span class="text-danger">*</span>
	                        </label>
	                        <select class="form-select" id="dealer-product-link-dealer" name="{{ prefix }}[dealer_id]" required>
	                            {% for dealer in dealer_all_dealers %}
		                            {% if dealer not in dealer_linked_dealers %}
			                            <option value="{{ dealer.id }}">{{ dealer.title }}</option>
		                            {% endif %}
	                            {% endfor %}
	                        </select>
	                    </div>
	                {% endif %}
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> {{ 'Yes'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="h5 mb-0">{{ 'Product linked to :'|trans({}, 'dealer.bo.default') }}</h3>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    {% for dealer in dealer_linked_dealers %}
                        <li>
                            {{ dealer.title }}
                            <button type="button" class="btn btn-link btn-sm p-0 product-delete"
                                    data-bs-toggle="modal" data-bs-target="#dealer-product-unlink" data-id="{{ dealer.id }}">
	                            <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </li>
                    {% else %}
                        <li class="text-muted">{{ 'There is no Product linked to this dealer'|trans({}, 'dealer.bo.default') }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>

{# DELETE modal #}
<div class="modal fade" id="dealer-product-unlink" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/admin/module/Dealer/product/delete?_token={{ assignToken() }}">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Unlink a product'|trans({}, 'dealer.bo.default') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    {{ 'Do you really want to unlink this product ?'|trans({}, 'dealer.bo.default') }}
                    <input type="hidden" name="dealer_product_link_id" value="{{ dealer_product_id }}">
                    <input type="hidden" id="dealer_product_link_delete_id" name="dealer_id" value="">
                    <input type="hidden" name="success_url" value="{{ dealer_current_url }}">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                    <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.product-delete').forEach(function (el) {
            el.addEventListener('click', function () {
                document.getElementById('dealer_product_link_delete_id').value = this.dataset.id;
            });
        });
    });
</script>
