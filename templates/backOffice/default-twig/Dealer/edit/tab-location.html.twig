{% form_theme geo_form with bo_form_themes only %}
<div class="tab-pane fade" id="location" role="tabpanel">
    <div class="row">
        <div class="col-md-6">
            {{ form_start(geo_form, {action: path('dealer_location_update')}) }}
                <input type="hidden" name="{{ field_name(geo_form.id) }}" value="{{ dealer_id }}">
                <input type="hidden" name="{{ field_name(geo_form.success_url) }}" value="{{ path('dealer_tab.edit', {dealer_id}) }}">
                {{ form_rest(geo_form) }}
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> {{ 'Save'|trans }}</button>
                </div>
            {{ form_end(geo_form) }}
        </div>
        <div class="col-md-6">
            {% set lat = geo_form.latitude.vars.value %}
            {% set lng = geo_form.longitude.vars.value %}
            {% if lat and lng %}
                <a href="https://www.openstreetmap.org/?mlat={{ lat }}&mlon={{ lng }}#map=16/{{ lat }}/{{ lng }}"
                   target="_blank" rel="noopener" class="btn btn-outline-secondary">
                    <i class="bi bi-geo-alt"></i> {{ 'View on OpenStreetMap'|trans({}, 'dealer.bo.default') }}
                </a>
            {% else %}
                <div class="alert alert-info mb-0">
                    {{ 'Set a latitude and a longitude to get a map link.'|trans({}, 'dealer.bo.default') }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
