{% set geo_fp = geo_form.vars.full_name %}
<div class="tab-pane fade" id="location" role="tabpanel">
    <div class="row">
        <div class="col-md-6">
            <form method="POST" action="/admin/module/Dealer/location/update?dealer_id={{ dealer_id }}" class="clearfix">
                <input type="hidden" name="{{ geo_fp }}[_token]" value="{{ geo_form._token.vars.value }}">
                <input type="hidden" name="{{ geo_fp }}[id]" value="{{ dealer_id }}">
                <input type="hidden" name="{{ geo_fp }}[success_url]" value="{{ path('dealer') }}">

                {{ form_widget(geo_form.latitude, {label: 'Latitude'|trans({}, 'dealer.bo.default'), attr: {step: 'any', placeholder: 'The Dealer latitude'|trans({}, 'dealer.bo.default')}}) }}
                {{ form_widget(geo_form.longitude, {label: 'Longitude'|trans({}, 'dealer.bo.default'), attr: {step: 'any', placeholder: 'The Dealer longitude'|trans({}, 'dealer.bo.default')}}) }}

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> {{ 'Save'|trans }}</button>
                </div>
            </form>
        </div>
        <div class="col-md-6">
            {% set lat = geo_form.latitude.vars.value %}
            {% set lng = geo_form.longitude.vars.value %}
            {% if lat and lng %}
                <a href="https://www.openstreetmap.org/?mlat={{ lat }}&mlon={{ lng }}#map=16/{{ lat }}/{{ lng }}"
                   target="_blank" rel="noopener" class="btn btn-outline-secondary">
                    <i class="bi bi-geo-alt"></i> {{ 'View on OpenStreetMap'|trans({}, 'dealer.bo.default') }}
                </a>
            {% else %}
                <div class="alert alert-info mb-0">
                    {{ 'Set a latitude and a longitude to get a map link.'|trans({}, 'dealer.bo.default') }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
