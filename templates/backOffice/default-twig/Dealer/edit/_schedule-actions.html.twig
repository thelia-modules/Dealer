<div class="btn-group">
    <button type="button" class="btn btn-outline-secondary btn-sm dealer-schedules-update-btn"
            data-bs-toggle="modal" data-bs-target="#dealer-schedules-update"
            data-id="{{ s.id }}" data-day="{{ s.day }}" data-begin="{{ s.begin }}" data-end="{{ s.end }}"
            data-periodbegin="{{ s.period_begin }}" data-periodend="{{ s.period_end }}">
        <i class="bi bi-pencil"></i>
    </button>
    <button type="button" class="btn btn-outline-secondary btn-sm dealer-schedules-clone-btn"
            data-bs-toggle="modal" data-bs-target="#dealer-schedules-clone" data-id="{{ s.id }}">
        <i class="bi bi-files"></i>
    </button>
    <button type="button" class="btn btn-outline-danger btn-sm dealer-schedules-delete-btn"
            data-bs-toggle="modal" data-bs-target="#dealer-schedules-delete" data-id="{{ s.id }}">
        <i class="bi bi-trash"></i>
    </button>
</div>
