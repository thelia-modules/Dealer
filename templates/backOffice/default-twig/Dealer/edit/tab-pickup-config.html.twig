{% set pc_fp = pickup_config_form.vars.full_name %}
<div class="tab-pane fade" id="pickup-config" role="tabpanel">
    <div class="row">
        <div class="col-md-6">
            <form method="POST" action="/admin/module/Dealer/pickup-config/update?dealer_id={{ dealer_id }}" class="clearfix">
                <input type="hidden" name="{{ pc_fp }}[_token]" value="{{ pickup_config_form._token.vars.value }}">
                <input type="hidden" name="{{ pc_fp }}[dealer_id]" value="{{ dealer_id }}">

                <div class="mb-3">
                    <label class="form-label">{{ 'Store timezone'|trans({}, 'dealer.bo.default') }}</label>
                    {{ form_widget(pickup_config_form.timezone, {attr: {class: 'form-select'}}) }}
                </div>
                <div class="mb-3">
                    <label class="form-label">{{ 'Preparation delay (minutes)'|trans({}, 'dealer.bo.default') }}</label>
                    {{ form_widget(pickup_config_form.prep_delay_minutes, {attr: {min: 0, class: 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    <label class="form-label">{{ 'Number of orderable days'|trans({}, 'dealer.bo.default') }}</label>
                    {{ form_widget(pickup_config_form.orderable_days, {attr: {min: 1, class: 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    <label class="form-label">{{ 'Slot duration (minutes)'|trans({}, 'dealer.bo.default') }}</label>
                    {{ form_widget(pickup_config_form.slot_duration_minutes, {attr: {min: 1, class: 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    <label class="form-label">{{ 'Max orders per slot (0 = unlimited)'|trans({}, 'dealer.bo.default') }}</label>
                    {{ form_widget(pickup_config_form.max_orders_per_slot, {attr: {min: 0, class: 'form-control'}}) }}
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> {{ 'Save'|trans }}</button>
                </div>
            </form>
        </div>
        <div class="col-md-6">
            <div class="alert alert-info mb-0">
                {{ 'These settings drive the pickup slots offered on the front-office for this store: the preparation delay before the first bookable slot, how many open days to display, the slot granularity, and the maximum number of orders per slot.'|trans({}, 'dealer.bo.default') }}
            </div>
        </div>
    </div>
</div>
