<script>
document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('[data-schedules-root]');
    if (!root) {
        return;
    }

    var I18N = {
        addSlot: {{ 'Add a slot'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        removeSlot: {{ 'Remove this slot'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        closedDay: {{ 'Closed'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        copyTo: {{ 'Copy to…'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        copyAll: {{ 'Every other day'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        saved: {{ 'Weekly hours saved.'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        saveError: {{ 'The weekly hours could not be saved.'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        networkError: {{ 'Network error — please try again.'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        previewEmpty: {{ 'No pickup slot is currently offered: check the hours, the exceptions and the pickup settings.'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        previewSlots: {{ '%count slots'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        previewLeft: {{ '%count left'|trans({}, 'dealer.bo.default')|json_encode|raw }},
        unsaved: {{ 'Unsaved changes'|trans({}, 'dealer.bo.default')|json_encode|raw }}
    };

    var dayLabels = JSON.parse(root.dataset.dayLabels);
    var week = JSON.parse(root.dataset.week);
    var grid = root.querySelector('[data-week-grid] tbody');
    var saveBtn = root.querySelector('[data-week-save]');
    var spinner = root.querySelector('[data-week-spinner]');
    var feedback = root.querySelector('[data-week-feedback]');
    var dirty = false;

    /* ---------------- Weekly grid ---------------- */

    function slotNode(begin, end) {
        var wrap = document.createElement('div');
        wrap.className = 'input-group input-group-sm w-auto d-inline-flex me-2 mb-1 align-top';
        wrap.setAttribute('data-slot', '');
        wrap.innerHTML =
            '<input type="time" class="form-control" data-slot-begin>' +
            '<span class="input-group-text">–</span>' +
            '<input type="time" class="form-control" data-slot-end>' +
            '<button type="button" class="btn btn-outline-danger" data-slot-remove title="' + I18N.removeSlot + '">' +
            '<i class="bi bi-x-lg"></i></button>';
        wrap.querySelector('[data-slot-begin]').value = begin || '';
        wrap.querySelector('[data-slot-end]').value = end || '';
        return wrap;
    }

    function dayRow(day) {
        var tr = document.createElement('tr');
        tr.setAttribute('data-day', day);

        var th = document.createElement('th');
        th.className = 'ps-3 text-nowrap';
        th.style.width = '9rem';
        th.textContent = dayLabels[day];
        tr.appendChild(th);

        var td = document.createElement('td');
        var slots = document.createElement('div');
        slots.setAttribute('data-slots', '');
        td.appendChild(slots);
        var error = document.createElement('div');
        error.className = 'text-danger small d-none';
        error.setAttribute('data-day-error', '');
        td.appendChild(error);
        tr.appendChild(td);

        var actions = document.createElement('td');
        actions.className = 'text-end text-nowrap pe-3';
        actions.style.width = '14rem';
        actions.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-primary" data-slot-add>' +
            '<i class="bi bi-plus-lg"></i> ' + I18N.addSlot + '</button> ' +
            '<div class="btn-group">' +
            '<button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">' +
            I18N.copyTo + '</button>' +
            '<ul class="dropdown-menu dropdown-menu-end" data-copy-menu></ul>' +
            '</div>';
        tr.appendChild(actions);

        var menu = actions.querySelector('[data-copy-menu]');
        var all = document.createElement('li');
        all.innerHTML = '<button type="button" class="dropdown-item fw-semibold" data-copy-target="all">' + I18N.copyAll + '</button>';
        menu.appendChild(all);
        dayLabels.forEach(function (label, target) {
            if (target === day) {
                return;
            }
            var li = document.createElement('li');
            li.innerHTML = '<button type="button" class="dropdown-item" data-copy-target="' + target + '">' + label + '</button>';
            menu.appendChild(li);
        });

        return tr;
    }

    function renderDaySlots(day) {
        var row = grid.querySelector('[data-day="' + day + '"]');
        var container = row.querySelector('[data-slots]');
        container.innerHTML = '';
        (week[day] || []).forEach(function (slot) {
            container.appendChild(slotNode(slot.begin, slot.end));
        });
        if (!(week[day] || []).length) {
            var closed = document.createElement('span');
            closed.className = 'badge text-bg-light text-muted border';
            closed.setAttribute('data-closed-label', '');
            closed.textContent = I18N.closedDay;
            container.appendChild(closed);
        }
    }

    function collectDay(day) {
        var row = grid.querySelector('[data-day="' + day + '"]');
        var slots = [];
        row.querySelectorAll('[data-slot]').forEach(function (node) {
            slots.push({
                begin: node.querySelector('[data-slot-begin]').value,
                end: node.querySelector('[data-slot-end]').value
            });
        });
        return slots;
    }

    function collectWeek() {
        var result = {};
        for (var day = 0; day < 7; day++) {
            result[day] = collectDay(day);
        }
        return result;
    }

    function markDirty() {
        dirty = true;
        saveBtn.disabled = false;
        showFeedback('warning', I18N.unsaved);
    }

    function showFeedback(kind, html) {
        feedback.classList.remove('d-none');
        feedback.innerHTML = '<div class="text-' + (kind === 'warning' ? 'warning-emphasis' : (kind === 'success' ? 'success' : 'danger')) + ' mb-0">' + html + '</div>';
    }

    function clearErrors() {
        grid.querySelectorAll('[data-day-error]').forEach(function (node) {
            node.classList.add('d-none');
            node.textContent = '';
        });
    }

    for (var day = 0; day < 7; day++) {
        grid.appendChild(dayRow(day));
        renderDaySlots(day);
    }

    grid.addEventListener('click', function (event) {
        var add = event.target.closest('[data-slot-add]');
        var remove = event.target.closest('[data-slot-remove]');
        var copy = event.target.closest('[data-copy-target]');
        var row = event.target.closest('[data-day]');
        if (!row) {
            return;
        }
        var day = parseInt(row.getAttribute('data-day'), 10);

        if (add) {
            week[day] = collectDay(day);
            var last = week[day][week[day].length - 1];
            week[day].push(last && last.end ? {begin: last.end, end: ''} : {begin: '09:00', end: '12:00'});
            renderDaySlots(day);
            markDirty();
        } else if (remove) {
            event.target.closest('[data-slot]').remove();
            week[day] = collectDay(day);
            renderDaySlots(day);
            markDirty();
        } else if (copy) {
            var source = collectDay(day);
            var targetAttr = copy.getAttribute('data-copy-target');
            var targets = targetAttr === 'all'
                ? [0, 1, 2, 3, 4, 5, 6].filter(function (d) { return d !== day; })
                : [parseInt(targetAttr, 10)];
            targets.forEach(function (target) {
                week[target] = source.map(function (slot) { return {begin: slot.begin, end: slot.end}; });
                renderDaySlots(target);
            });
            markDirty();
        }
    });

    grid.addEventListener('change', function (event) {
        if (event.target.matches('[data-slot-begin], [data-slot-end]')) {
            markDirty();
        }
    });

    saveBtn.addEventListener('click', function () {
        clearErrors();
        saveBtn.disabled = true;
        spinner.classList.remove('d-none');

        fetch(root.dataset.weekUrl, {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify({dealer_id: parseInt(root.dataset.dealerId, 10), week: collectWeek()})
        }).then(function (response) {
            return response.json().then(function (data) { return {ok: response.ok, data: data}; });
        }).then(function (result) {
            spinner.classList.add('d-none');
            if (result.ok && result.data.success) {
                dirty = false;
                for (var day = 0; day < 7; day++) {
                    week[day] = collectDay(day).filter(function (slot) { return slot.begin && slot.end; });
                    renderDaySlots(day);
                }
                showFeedback('success', '<i class="bi bi-check-circle"></i> ' + I18N.saved);
                loadPreview();
            } else {
                saveBtn.disabled = false;
                var errors = result.data.errors || {};
                Object.keys(errors).forEach(function (day) {
                    var row = grid.querySelector('[data-day="' + day + '"]');
                    if (row) {
                        var node = row.querySelector('[data-day-error]');
                        node.textContent = errors[day].join(' ');
                        node.classList.remove('d-none');
                    }
                });
                showFeedback('danger', result.data.message || I18N.saveError);
            }
        }).catch(function () {
            spinner.classList.add('d-none');
            saveBtn.disabled = false;
            showFeedback('danger', I18N.networkError);
        });
    });

    /* ---------------- Customer preview ---------------- */

    function loadPreview() {
        var body = root.querySelector('[data-preview-body]');
        fetch(root.dataset.previewUrl, {headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (!data.success || !data.days || !data.days.length) {
                    body.innerHTML = '<div class="alert alert-warning mb-0">' + I18N.previewEmpty + '</div>';
                    return;
                }
                var html = '<div class="d-flex flex-wrap gap-2">';
                data.days.forEach(function (day) {
                    var date = new Date(day.date + 'T00:00:00');
                    var times = day.slots.map(function (slot) {
                        var badge = slot.remaining !== null
                            ? ' <span class="badge text-bg-' + (slot.remaining <= 1 ? 'danger' : 'secondary') + '">' + I18N.previewLeft.replace('%count', slot.remaining) + '</span>'
                            : '';
                        return '<span class="d-inline-block text-nowrap me-2">' + slot.time + badge + '</span>';
                    }).join('');
                    html += '<div class="border rounded p-2" style="min-width: 11rem">'
                        + '<div class="fw-semibold text-capitalize">' + dayLabels[day.day] + ' ' + date.toLocaleDateString() + '</div>'
                        + '<div class="text-muted small">' + I18N.previewSlots.replace('%count', day.slots.length) + '</div>'
                        + '<div class="small mt-1">' + times + '</div>'
                        + '</div>';
                });
                body.innerHTML = html + '</div>';
            })
            .catch(function () {
                body.innerHTML = '<div class="alert alert-warning mb-0">' + I18N.networkError + '</div>';
            });
    }

    loadPreview();

    /* ---------------- Exception modals ---------------- */

    function bindExceptionForm(form) {
        var modal = form.closest('.modal');
        var variant = form.getAttribute('data-exc-variant');
        var closedInput = form.querySelector('[data-exc-closed]');
        var recurringInput = form.querySelector('[data-exc-recurring]');
        var daysWrap = form.querySelector('[data-exc-days]');
        var dateLabel = form.querySelector('[data-exc-date-label]');
        var dateInput = form.querySelector('[data-exc-date]');
        var periodEndWrap = form.querySelector('[data-exc-period-end-wrap]');
        var periodEndInput = form.querySelector('[data-exc-period-end]');
        var fullDayWrap = form.querySelector('[data-exc-fullday-wrap]');
        var fullDay = form.querySelector('[data-exc-fullday]');
        var hours = form.querySelector('[data-exc-hours]');
        var beginInput = form.querySelector('[data-exc-begin]');
        var endInput = form.querySelector('[data-exc-end]');
        var errorBox = form.querySelector('[data-exc-error]');
        var modeHelp = form.querySelector('[data-exc-mode-help]');
        var titleEl = form.querySelector('[data-exc-title]');

        function currentKind() {
            var checked = form.querySelector('[data-exc-kind-radio]:checked');
            return checked ? checked.value : 'closure';
        }

        function currentMode() {
            var checked = form.querySelector('[data-exc-mode-radio]:checked');
            return checked ? checked.value : 'date';
        }

        function refresh() {
            var kind = currentKind();
            var mode = currentMode();

            closedInput.value = kind === 'closure' ? '1' : '0';
            recurringInput.value = mode === 'yearly' ? '1' : '0';

            if (titleEl) {
                titleEl.textContent = titleEl.getAttribute('data-title-' + kind) || titleEl.textContent;
            }
            if (modeHelp) {
                modeHelp.textContent = modeHelp.getAttribute('data-help-' + mode) || '';
            }
            if (daysWrap) {
                daysWrap.classList.toggle('d-none', mode !== 'weekly');
            }
            if (dateLabel) {
                dateLabel.textContent = dateLabel.getAttribute('data-label-' + mode);
            }
            if (periodEndWrap) {
                periodEndWrap.classList.toggle('d-none', mode !== 'period' && mode !== 'weekly');
            }

            // Only a closure can cover the whole day; an opening always needs hours.
            var isClosure = kind === 'closure';
            fullDayWrap.classList.toggle('d-none', !isClosure);
            if (!isClosure) {
                fullDay.checked = false;
            }
            hours.classList.toggle('d-none', isClosure && fullDay.checked);
        }

        form.querySelectorAll('[data-exc-kind-radio], [data-exc-mode-radio]').forEach(function (radio) {
            radio.addEventListener('change', refresh);
        });
        fullDay.addEventListener('change', refresh);

        modal.addEventListener('show.bs.modal', function (event) {
            var trigger = event.relatedTarget;
            errorBox.classList.add('d-none');

            if (variant === 'create') {
                form.reset();
                var kind = trigger && trigger.getAttribute('data-exc-kind') === 'opening' ? 'opening' : 'closure';
                form.querySelectorAll('[data-exc-kind-radio]').forEach(function (radio) {
                    radio.checked = radio.value === kind;
                });
                form.querySelectorAll('[data-exc-mode-radio]').forEach(function (radio) {
                    radio.checked = radio.value === 'date';
                });
                fullDay.checked = true;
            } else if (trigger) {
                // The generic data-fill prefill (id, title) runs in the shared handler;
                // everything mode-related is restored here.
                var mode = trigger.getAttribute('data-mode') || 'date';
                var kindAttr = trigger.getAttribute('data-kind') || 'closure';
                form.querySelectorAll('[data-exc-kind-radio]').forEach(function (radio) {
                    radio.checked = radio.value === kindAttr;
                });
                form.querySelectorAll('[data-exc-mode-radio]').forEach(function (radio) {
                    radio.checked = radio.value === mode;
                });
                var daySingle = form.querySelector('[data-exc-day-single]');
                if (daySingle) {
                    daySingle.value = trigger.getAttribute('data-day') || '';
                }
                dateInput.value = trigger.getAttribute('data-periodbegin') || '';
                periodEndInput.value = (mode === 'yearly') ? '' : (trigger.getAttribute('data-periodend') || '');
                fullDay.checked = trigger.getAttribute('data-fullday') === '1';
                if (beginInput) {
                    beginInput.value = trigger.getAttribute('data-begin') || '';
                }
                if (endInput) {
                    endInput.value = trigger.getAttribute('data-end') || '';
                }
            }

            refresh();
        });

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            errorBox.classList.add('d-none');

            var mode = currentMode();

            // Normalize the posted fields to what each mode means.
            if (mode === 'date') {
                periodEndInput.value = dateInput.value;
                clearDays();
            } else if (mode === 'yearly') {
                periodEndInput.value = '';
                clearDays();
            } else if (mode === 'period') {
                clearDays();
            }
            if (currentKind() === 'closure' && fullDay.checked && beginInput && endInput) {
                beginInput.value = '';
                endInput.value = '';
            }

            var submitBtn = form.querySelector('[data-exc-submit]');
            var excSpinner = form.querySelector('[data-exc-spinner]');
            submitBtn.disabled = true;
            excSpinner.classList.remove('d-none');

            fetch(form.action, {
                method: 'POST',
                headers: {'X-Requested-With': 'XMLHttpRequest'},
                body: new FormData(form)
            }).then(function (response) {
                return response.json().then(function (data) { return {ok: response.ok, data: data}; });
            }).then(function (result) {
                if (result.ok && result.data.success) {
                    window.location.hash = '#schedules';
                    window.location.reload();
                } else {
                    submitBtn.disabled = false;
                    excSpinner.classList.add('d-none');
                    errorBox.textContent = result.data.message || I18N.saveError;
                    errorBox.classList.remove('d-none');
                }
            }).catch(function () {
                submitBtn.disabled = false;
                excSpinner.classList.add('d-none');
                errorBox.textContent = I18N.networkError;
                errorBox.classList.remove('d-none');
            });
        });

        function clearDays() {
            form.querySelectorAll('[data-exc-day-check]').forEach(function (check) {
                check.checked = false;
            });
            var daySingle = form.querySelector('[data-exc-day-single]');
            if (daySingle) {
                daySingle.value = '';
            }
        }
    }

    document.querySelectorAll('[data-exception-form]').forEach(bindExceptionForm);

    var deleteForm = document.querySelector('[data-exception-delete]');
    if (deleteForm) {
        deleteForm.addEventListener('submit', function (event) {
            event.preventDefault();
            var errorBox = deleteForm.querySelector('[data-exc-error]');
            errorBox.classList.add('d-none');

            fetch(deleteForm.action, {
                method: 'POST',
                headers: {'X-Requested-With': 'XMLHttpRequest'},
                body: new FormData(deleteForm)
            }).then(function (response) {
                return response.json().then(function (data) { return {ok: response.ok, data: data}; });
            }).then(function (result) {
                if (result.ok && result.data.success) {
                    window.location.hash = '#schedules';
                    window.location.reload();
                } else {
                    errorBox.textContent = result.data.message || I18N.saveError;
                    errorBox.classList.remove('d-none');
                }
            }).catch(function () {
                errorBox.textContent = I18N.networkError;
                errorBox.classList.remove('d-none');
            });
        });
    }
});
</script>
