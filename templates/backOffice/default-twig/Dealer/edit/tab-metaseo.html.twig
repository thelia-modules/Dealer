{% set seo_fp = seo_form.vars.full_name %}
<div class="tab-pane fade" id="metaseo" role="tabpanel">
    <form method="POST" action="/admin/module/dealer/seo" class="clearfix">
        <input type="hidden" name="{{ seo_fp }}[_token]" value="{{ seo_form._token.vars.value }}">
        <input type="hidden" name="{{ seo_fp }}[dealer_id]" value="{{ dealer_id }}">

        <div class="mb-3">
            <label class="form-label">{{ 'Slug SEO'|trans({}, 'dealer.bo.default') }}</label>
            {{ form_widget(seo_form.slug, {attr: {class: 'form-control'}}) }}
        </div>
        <hr>
        <div class="mb-3">
            <label class="form-label">{{ 'Title SEO'|trans({}, 'dealer.bo.default') }}</label>
            {{ form_widget(seo_form.meta_title, {attr: {class: 'form-control'}}) }}
        </div>
        <div class="mb-3">
            <label class="form-label">{{ 'Description SEO'|trans({}, 'dealer.bo.default') }}</label>
            {{ form_widget(seo_form.meta_description, {attr: {class: 'form-control', rows: 3}}) }}
        </div>
        <div class="mb-3">
            <label class="form-label">{{ 'Keywords SEO'|trans({}, 'dealer.bo.default') }}</label>
            {{ form_widget(seo_form.meta_keywords, {attr: {class: 'form-control'}}) }}
        </div>
        <div class="mb-3">
            <label class="form-label">{{ 'Meta json'|trans({}, 'dealer.bo.default') }}</label>
            {{ form_widget(seo_form.meta_json, {attr: {class: 'form-control', rows: 3}}) }}
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> {{ 'Save'|trans }}</button>
        </div>
    </form>
</div>
