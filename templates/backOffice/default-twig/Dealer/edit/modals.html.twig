{# ====================== EXCEPTION DELETE ====================== #}
<div class="modal fade dealer-modal" id="dealer-exception-delete" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="{{ token_url('dealer_schedules_delete') }}" class="modal-content" data-exception-delete>
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Delete this exception'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {{ 'Do you really want to delete this exception?'|trans({}, 'dealer.bo.default') }}
                <input type="hidden" name="dealer-schedules_id" value="" data-fill="id">
                <input type="hidden" name="dealer_id" value="{{ dealer_id }}">
                <input type="hidden" name="success_url" value="{{ schedules_url }}">
                <div class="alert alert-danger d-none mt-3" data-exc-error></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
            </div>
        </form>
    </div>
</div>

{# ====================== ADMIN LINK ====================== #}
<div class="modal fade dealer-modal" id="dealer-admin-link" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="/admin/module/Dealer/admin" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Link a Admin'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="{{ admin_link_fp }}[_token]" value="{{ admin_link_form._token.vars.value }}">
                <input type="hidden" name="{{ admin_link_fp }}[dealer_id]" value="{{ dealer_id }}">
                <input type="hidden" name="{{ admin_link_fp }}[success_url]" value="{{ users_url }}">
                <div class="mb-3">
                    <label class="form-label">{{ 'Admin'|trans({}, 'dealer.bo.default') }}</label>
                    {{ form_widget(admin_link_form.admin_id, {attr: {class: 'form-select'}}) }}
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-primary">{{ 'Create'|trans }}</button>
            </div>
        </form>
    </div>
</div>

{# ====================== ADMIN UNLINK ====================== #}
<div class="modal fade dealer-modal" id="dealer-admin-unlink" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="/admin/module/Dealer/admin/delete?_token={{ assignToken() }}" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Unlink a admin'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {{ 'Do you really want to unlink this admin ?'|trans({}, 'dealer.bo.default') }}
                <input type="hidden" name="dealer_admin_link_id" value="" data-fill="id">
                <input type="hidden" name="dealer_id" value="{{ dealer_id }}">
                <input type="hidden" name="success_url" value="{{ users_url }}">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
            </div>
        </form>
    </div>
</div>
