{# ====================== SCHEDULES CREATE ====================== #}
<div class="modal fade dealer-modal" id="dealer-schedules-create" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form method="POST" action="/admin/module/Dealer/schedules" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Create a schedules'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="{{ schedules_create_fp }}[_token]" value="{{ schedules_create_form._token.vars.value }}">
                <input type="hidden" name="{{ schedules_create_fp }}[dealer_id]" value="{{ dealer_id }}">
                <input type="hidden" name="{{ schedules_create_fp }}[success_url]" value="{{ schedules_url }}">
                <input type="hidden" name="{{ schedules_create_fp }}[error_url]" value="{{ schedules_url }}">
                <input type="hidden" name="{{ schedules_create_fp }}[closed]" value="0" data-fill="closed">
                <div class="mb-3">
                    <label class="form-label">{{ 'Day'|trans({}, 'dealer.bo.default') }}</label>
                    <select class="form-select" name="{{ schedules_create_fp }}[day][]" multiple>
                        {% for idx, label in day_labels %}
                            <option value="{{ idx }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <h6>{{ 'AM'|trans({}, 'dealer.bo.default') }}</h6>
                        <div class="mb-3">
                            <label class="form-label">{{ 'Begin'|trans({}, 'dealer.bo.default') }}</label>
                            <input type="time" class="form-control" name="{{ schedules_create_fp }}[beginAM]" value="09:00">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">{{ 'End'|trans({}, 'dealer.bo.default') }}</label>
                            <input type="time" class="form-control" name="{{ schedules_create_fp }}[endAM]" value="12:00">
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <h6>{{ 'PM'|trans({}, 'dealer.bo.default') }}</h6>
                        <div class="mb-3">
                            <label class="form-label">{{ 'Begin'|trans({}, 'dealer.bo.default') }}</label>
                            <input type="time" class="form-control" name="{{ schedules_create_fp }}[beginPM]" value="14:00">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">{{ 'End'|trans({}, 'dealer.bo.default') }}</label>
                            <input type="time" class="form-control" name="{{ schedules_create_fp }}[endPM]" value="19:00">
                        </div>
                    </div>
                </div>
                <h6>{{ 'Period'|trans({}, 'dealer.bo.default') }}</h6>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label class="form-label">{{ 'Period Begin'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="date" class="form-control" name="{{ schedules_create_fp }}[period_begin]">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label class="form-label">{{ 'Period End'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="date" class="form-control" name="{{ schedules_create_fp }}[period_end]">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">{{ 'Label'|trans({}, 'dealer.bo.default') }}</label>
                    <input type="text" class="form-control" name="{{ schedules_create_fp }}[title]" placeholder="{{ 'e.g. Public holiday, special event…'|trans({}, 'dealer.bo.default') }}">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-primary">{{ 'Create'|trans }}</button>
            </div>
        </form>
    </div>
</div>

