{% set contact_create_fp = contact_create_form.vars.full_name %}
{% set contact_update_fp = contact_update_form.vars.full_name %}
{% set contact_info_create_fp = contact_info_create_form.vars.full_name %}
{% set contact_info_update_fp = contact_info_update_form.vars.full_name %}
{% set schedules_create_fp = schedules_create_form.vars.full_name %}
{% set schedules_update_fp = schedules_update_form.vars.full_name %}
{% set admin_link_fp = admin_link_form.vars.full_name %}
{% set contacts_url = '/admin/module/Dealer/dealer/edit?dealer_id=' ~ dealer_id ~ '#contacts' %}
{% set schedules_url = '/admin/module/Dealer/dealer/edit?dealer_id=' ~ dealer_id ~ '#schedules' %}
{% set users_url = '/admin/module/Dealer/dealer/edit?dealer_id=' ~ dealer_id ~ '#users' %}

{# ====================== CONTACT CREATE ====================== #}
<div class="modal fade dealer-modal" id="dealer-contact-create" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="/admin/module/Dealer/contact" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Create a Contact'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="{{ contact_create_fp }}[_token]" value="{{ contact_create_form._token.vars.value }}">
                <input type="hidden" name="{{ contact_create_fp }}[locale]" value="{{ edit_language_locale }}">
                <input type="hidden" name="{{ contact_create_fp }}[dealer_id]" value="{{ dealer_id }}">
                <input type="hidden" name="{{ contact_create_fp }}[success_url]" value="{{ contacts_url }}">
                <div class="mb-3">
                    <label class="form-label">{{ 'Label'|trans({}, 'dealer.bo.default') }}</label>
                    <input type="text" class="form-control" name="{{ contact_create_fp }}[label]" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-primary">{{ 'Create'|trans }}</button>
            </div>
        </form>
    </div>
</div>

{# ====================== CONTACT UPDATE ====================== #}
<div class="modal fade dealer-modal" id="dealer-contact-update" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="/admin/module/Dealer/contact/update" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Modify a Contact'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="{{ contact_update_fp }}[_token]" value="{{ contact_update_form._token.vars.value }}">
                <input type="hidden" name="{{ contact_update_fp }}[locale]" value="{{ edit_language_locale }}">
                <input type="hidden" name="{{ contact_update_fp }}[dealer_id]" value="{{ dealer_id }}">
                <input type="hidden" name="{{ contact_update_fp }}[success_url]" value="{{ contacts_url }}">
                <input type="hidden" name="{{ contact_update_fp }}[id]" value="" data-fill="id">
                <div class="mb-3">
                    <label class="form-label">{{ 'Label'|trans({}, 'dealer.bo.default') }}</label>
                    <input type="text" class="form-control" name="{{ contact_update_fp }}[label]" value="" data-fill="label" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
            </div>
        </form>
    </div>
</div>

{# ====================== CONTACT DELETE ====================== #}
<div class="modal fade dealer-modal" id="dealer-contact-delete" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="/admin/module/Dealer/contact/delete?_token={{ assignToken() }}" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Delete an entry of Contact'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {{ 'Do you really want to delete this Contact ?'|trans({}, 'dealer.bo.default') }}
                <input type="hidden" name="dealer-contact_id" value="" data-fill="id">
                <input type="hidden" name="dealer_id" value="{{ dealer_id }}">
                <input type="hidden" name="success_url" value="{{ contacts_url }}">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
            </div>
        </form>
    </div>
</div>

