        <form method="POST" action="/admin/module/Dealer/admin/delete?_token={{ assignToken() }}" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Unlink a admin'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {{ 'Do you really want to unlink this admin ?'|trans({}, 'dealer.bo.default') }}
                <input type="hidden" name="dealer_admin_link_id" value="" data-fill="id">
                <input type="hidden" name="dealer_id" value="{{ dealer_id }}">
                <input type="hidden" name="success_url" value="{{ users_url }}">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
            </div>
        </form>
    </div>
</div>
