{# ====================== EXCEPTION CREATE ====================== #}
<div class="modal fade dealer-modal" id="dealer-exception-create" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form method="POST" action="{{ path('dealer_schedules_create') }}" class="modal-content"
              data-exception-form data-exc-variant="create">
            <div class="modal-header">
                <h5 class="modal-title" data-exc-title
                    data-title-closure="{{ 'Add a closure'|trans({}, 'dealer.bo.default') }}"
                    data-title-opening="{{ 'Add an exceptional opening'|trans({}, 'dealer.bo.default') }}">{{ 'Add a closure'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="{{ schedules_create_fp }}[_token]" value="{{ schedules_create_form._token.vars.value }}">
                <input type="hidden" name="{{ schedules_create_fp }}[dealer_id]" value="{{ dealer_id }}">
                <input type="hidden" name="{{ schedules_create_fp }}[success_url]" value="{{ schedules_url }}">
                <input type="hidden" name="{{ schedules_create_fp }}[error_url]" value="{{ schedules_url }}">
                <input type="hidden" name="{{ schedules_create_fp }}[exception]" value="1">
                <input type="hidden" name="{{ schedules_create_fp }}[closed]" value="1" data-exc-closed>
                <input type="hidden" name="{{ schedules_create_fp }}[recurring]" value="0" data-exc-recurring>

                <div class="alert alert-danger d-none" data-exc-error></div>

                <div class="mb-3">
                    <label class="form-label d-block">{{ 'Type'|trans({}, 'dealer.bo.default') }}</label>
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="exc-kind-create" id="exc-kind-closure-create" value="closure" checked autocomplete="off" data-exc-kind-radio>
                        <label class="btn btn-outline-danger" for="exc-kind-closure-create">{{ 'Closure'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="radio" class="btn-check" name="exc-kind-create" id="exc-kind-opening-create" value="opening" autocomplete="off" data-exc-kind-radio>
                        <label class="btn btn-outline-success" for="exc-kind-opening-create">{{ 'Opening'|trans({}, 'dealer.bo.default') }}</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">{{ 'Repeats'|trans({}, 'dealer.bo.default') }}</label>
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" class="btn-check" name="exc-mode-create" id="exc-mode-date-create" value="date" checked autocomplete="off" data-exc-mode-radio>
                        <label class="btn btn-outline-primary" for="exc-mode-date-create">{{ 'Precise date'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="radio" class="btn-check" name="exc-mode-create" id="exc-mode-period-create" value="period" autocomplete="off" data-exc-mode-radio>
                        <label class="btn btn-outline-primary" for="exc-mode-period-create">{{ 'Period'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="radio" class="btn-check" name="exc-mode-create" id="exc-mode-weekly-create" value="weekly" autocomplete="off" data-exc-mode-radio>
                        <label class="btn btn-outline-primary" for="exc-mode-weekly-create">{{ 'Every week'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="radio" class="btn-check" name="exc-mode-create" id="exc-mode-yearly-create" value="yearly" autocomplete="off" data-exc-mode-radio>
                        <label class="btn btn-outline-primary" for="exc-mode-yearly-create">{{ 'Every year'|trans({}, 'dealer.bo.default') }}</label>
                    </div>
                    <div class="form-text" data-exc-mode-help
                         data-help-date="{{ 'Applies on that single date.'|trans({}, 'dealer.bo.default') }}"
                         data-help-period="{{ 'Applies every day of the period.'|trans({}, 'dealer.bo.default') }}"
                         data-help-weekly="{{ 'Applies on the selected weekdays, within the optional period below. Leave the period empty to repeat with no end date.'|trans({}, 'dealer.bo.default') }}"
                         data-help-yearly="{{ 'Applies every year on that day and month; the year is ignored.'|trans({}, 'dealer.bo.default') }}"></div>
                </div>

                <div class="mb-3 d-none" data-exc-days>
                    <label class="form-label d-block">{{ 'Days of the week'|trans({}, 'dealer.bo.default') }}</label>
                    <div class="btn-group btn-group-sm flex-wrap" role="group">
                        {% for idx, label in day_labels %}
                            <input type="checkbox" class="btn-check" name="{{ schedules_create_fp }}[day][]" value="{{ idx }}"
                                   id="exc-day-{{ idx }}-create" autocomplete="off" data-exc-day-check>
                            <label class="btn btn-outline-secondary" for="exc-day-{{ idx }}-create">{{ label }}</label>
                        {% endfor %}
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label class="form-label" data-exc-date-label
                               data-label-date="{{ 'Date'|trans({}, 'dealer.bo.default') }}"
                               data-label-period="{{ 'Period Begin'|trans({}, 'dealer.bo.default') }}"
                               data-label-weekly="{{ 'Period Begin (optional)'|trans({}, 'dealer.bo.default') }}"
                               data-label-yearly="{{ 'Date (repeated every year)'|trans({}, 'dealer.bo.default') }}">{{ 'Date'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="date" class="form-control" name="{{ schedules_create_fp }}[period_begin]" data-exc-date>
                    </div>
                    <div class="col-sm-6 mb-3 d-none" data-exc-period-end-wrap>
                        <label class="form-label">{{ 'Period End'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="date" class="form-control" name="{{ schedules_create_fp }}[period_end]" data-exc-period-end>
                    </div>
                </div>

                <div class="form-check form-switch mb-3" data-exc-fullday-wrap>
                    <input class="form-check-input" type="checkbox" id="exc-fullday-create" checked data-exc-fullday>
                    <label class="form-check-label" for="exc-fullday-create">{{ 'Whole day'|trans({}, 'dealer.bo.default') }}</label>
                </div>

                <div class="row d-none" data-exc-hours>
                    <div class="col-sm-6 mb-3">
                        <label class="form-label">{{ 'Begin'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="time" class="form-control" name="{{ schedules_create_fp }}[slots][0][begin]" data-exc-begin>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label class="form-label">{{ 'End'|trans({}, 'dealer.bo.default') }}</label>
                        <input type="time" class="form-control" name="{{ schedules_create_fp }}[slots][0][end]" data-exc-end>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ 'Label'|trans({}, 'dealer.bo.default') }}</label>
                    <input type="text" class="form-control" name="{{ schedules_create_fp }}[title]"
                           placeholder="{{ 'e.g. Public holiday, special event…'|trans({}, 'dealer.bo.default') }}">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-primary" data-exc-submit>
                    <span class="spinner-border spinner-border-sm me-1 d-none" data-exc-spinner aria-hidden="true"></span>{{ 'Create'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>

