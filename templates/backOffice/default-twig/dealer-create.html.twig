<div class="modal fade" id="dealer-create" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Create an entry of Dealer'|trans({}, 'dealer.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            {% form_theme create_form with bo_form_themes only %}
            {{ form_start(create_form, {action: '/admin/module/Dealer/dealer', attr: {class: 'modal-form'}}) }}
            <input type="hidden" name="{{ field_name(create_form.success_url) }}" value="{{ path('dealer') }}">

            <div class="modal-body">
                {{ form_rest(create_form) }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-primary">{{ 'Create'|trans }}</button>
            </div>
            {{ form_end(create_form) }}

        </div>
    </div>
</div>



